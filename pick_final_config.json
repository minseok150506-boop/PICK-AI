{
  "name": "PICK PERFECT FINAL",
  "version": "final-2026",
  "language": "ko",
  "features": [
    "korean_only_prompt",
    "chatgpt_style_ui",
    "typing_indicator",
    "auto_scroll",
    "duplicate_send_protection",
    "thinking_mode",
    "typo_learning",
    "ollama_auto_fallback",
    "ctrl_v_upload_analysis"
  ],
  "default_llm_mode": "auto",
  "default_ollama_model": "llama3",
  "automation": {
    "enabled": true,
    "script": "automation.py",
    "default_mode": "auto",
    "default_interval_minutes": 60
  },
  "llm_power_mode": {
    "default": "qwen2.5:32b",
    "fallbacks": [
      "qwen2.5:14b",
      "llama3"
    ],
    "note": "큰 모델일수록 더 많은 RAM/VRAM과 시간이 필요합니다."
  }
}